# 環境変数の名前だけを書きます。値は書きません。
# このファイルを .env.local にコピーして値を入れてください（.env.local は git に入りません）。
# ローカルの値は `npx supabase status` で確認できます。

# --- ブラウザにも渡る公開の値 ---
# Supabase の API の URL（ローカルは http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の公開キー（publishable key）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- サーバーだけで使う秘密の値（NEXT_PUBLIC_ を付けない） ---
# Supabase の secret key（service_role）。RLS を通らないので漏らさない。
# 拾った人の連絡の保存、通知先の確認、タグ発行スクリプトで使う。
SUPABASE_SECRET_KEY=

# サイトの URL（通知メールのリンクに使う。例: https://example.com）
SITE_URL=

# 通知メールの送り方: resend（本番）/ mailpit（ローカルのテスト用受信箱）/ log（送らない。既定）
MAIL_PROVIDER=
# 送信元（例: 持ち物タグ <no-reply@example.com>）
MAIL_FROM=
# Resend の API キー（MAIL_PROVIDER=resend のとき）
RESEND_API_KEY=
# Mailpit の URL（MAIL_PROVIDER=mailpit のとき。ローカルは http://127.0.0.1:54324）
MAILPIT_URL=
