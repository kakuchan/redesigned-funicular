# ローカル開発用の環境変数の名前だけを書きます。値は書きません。
# このファイルを .env.local にコピーして値を入れてください（.env.local は git に入りません）。
# ローカルの値は `npx supabase status` で確認できます。

# Supabase の API の URL（ローカルは http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の公開キー（publishable key）。ブラウザに渡ってよいキーです。
# サービスロールキー／secret key はここに書かず、NEXT_PUBLIC_ も付けません。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 運営用スクリプト（scripts/）だけで使う。アプリには入れない ---
# Supabase の secret key（service_role）。RLS を通らないので、運営の端末以外に置かない。
SUPABASE_SECRET_KEY=
